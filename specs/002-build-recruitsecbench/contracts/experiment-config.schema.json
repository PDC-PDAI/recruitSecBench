{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-config.schema.json",
  "title": "RecruitSecBench experiment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "benchmark_namespace",
    "partition",
    "conditions",
    "models",
    "repetitions",
    "seeds",
    "artifact_manifests",
    "repository_commits",
    "failure_policy",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "benchmark_namespace": {
      "type": "string",
      "enum": [
        "agentdojo_standard",
        "official_control_reproduction",
        "recruitsecbench_simulator",
        "recruitsecbench_application"
      ]
    },
    "partition": {
      "type": "string",
      "enum": ["development", "pilot", "evaluation", "holdout"]
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["C0", "C1", "C2", "C3"]
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_key", "provider", "model_id", "settings"],
        "properties": {
          "model_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "provider": {
            "type": "string",
            "enum": ["openai", "ceia", "mock"]
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "settings": {
            "type": "object"
          },
          "endpoint_class": {
            "type": "string",
            "enum": ["external_paid", "external_internal", "local", "deterministic_mock"]
          }
        }
      }
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "artifact_manifests": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "repository_commits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recruitsecbench",
        "rh_agent_agno",
        "smart_rh_platform",
        "agentrh_infra"
      ],
      "properties": {
        "recruitsecbench": { "$ref": "#/$defs/gitCommit" },
        "rh_agent_agno": { "$ref": "#/$defs/gitCommit" },
        "smart_rh_platform": { "$ref": "#/$defs/gitCommit" },
        "agentrh_infra": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "prompt_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tool_contract_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retryable_statuses", "max_attempts", "preserve_all_attempts"],
      "properties": {
        "retryable_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "provider_error",
              "transport_error",
              "harness_error",
              "timeout",
              "cancelled"
            ]
          }
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "preserve_all_attempts": {
          "const": true
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "max_cost", "block_before_exceeding"],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "block_before_exceeding": {
          "const": true
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explicit": {
          "type": "boolean"
        },
        "confirmed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "protocol_freeze_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "partition": {
            "enum": ["evaluation", "holdout"]
          }
        }
      },
      "then": {
        "required": ["confirmation"],
        "properties": {
          "confirmation": {
            "required": ["explicit", "confirmed_at", "protocol_freeze_sha256"],
            "properties": {
              "explicit": { "const": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
