{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adversarial.schema.json",
  "title": "RecruitSecBench adversarial case record",
  "description": "One attack case, preferably derived from a benign case, with explicit validity and attack-success oracles.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "case_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "case_kind": { "const": "adversarial" },
    "partition": { "$ref": "common.schema.json#/$defs/partition" },
    "title": { "type": "string", "minLength": 1 },
    "benign_case_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "actor": { "$ref": "common.schema.json#/$defs/actorContext" },
    "input_record_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/identifier" },
      "minItems": 1,
      "uniqueItems": true
    },
    "fixture_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/identifier" },
      "uniqueItems": true
    },
    "initial_state": { "type": "object" },
    "request": { "$ref": "common.schema.json#/$defs/request" },
    "attack": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "enum": ["prompt_injection", "score_manipulation", "unauthorized_tool", "argument_tampering", "cross_scope_access", "document_exfiltration", "session_misuse", "invalid_state_transition", "duplicate_persistence", "auditor_evasion", "rag_poisoning"]
        },
        "surface": {
          "type": "string",
          "enum": ["vacancy", "cv", "candidate_response", "rag", "session", "tool", "mcp", "state", "auditor"]
        },
        "delivery": {
          "type": "string",
          "enum": ["direct_prompt", "indirect_content", "tool_argument", "id_substitution", "session_replay", "state_manipulation", "retrieval_poisoning"]
        },
        "targeted": { "type": "boolean" },
        "goal": { "type": "string", "minLength": 1 },
        "attacker_capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "payloads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "placement": { "type": "string", "minLength": 1 },
              "content": { "type": "string", "minLength": 1 },
              "content_ref": { "$ref": "common.schema.json#/$defs/identifier" },
              "encoding": { "type": "string", "enum": ["plain", "json", "markdown", "base64", "unicode_obfuscated"] }
            },
            "required": ["placement", "encoding"],
            "anyOf": [{ "required": ["content"] }, { "required": ["content_ref"] }],
            "additionalProperties": false
          }
        },
        "prohibited_outcomes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
      },
      "required": ["family", "surface", "delivery", "targeted", "goal", "attacker_capabilities", "payloads", "prohibited_outcomes", "severity"],
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "policy_decision": { "type": "string", "enum": ["BLOCK", "HUMAN_REVIEW"] },
        "validity_oracles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/oracle" }, "minItems": 1 },
        "attack_success_oracles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/oracle" }, "minItems": 1 },
        "safe_behavior_oracles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/oracle" }, "minItems": 1 }
      },
      "required": ["policy_decision", "validity_oracles", "attack_success_oracles", "safe_behavior_oracles"],
      "additionalProperties": false
    },
    "controls_under_test": {
      "type": "array",
      "items": { "type": "string", "enum": ["S1", "S2", "S3", "S4"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "primary_metrics": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "required": ["schema_version", "case_id", "case_kind", "partition", "title", "actor", "input_record_ids", "initial_state", "request", "attack", "expected", "controls_under_test", "primary_metrics"],
  "additionalProperties": false
}
