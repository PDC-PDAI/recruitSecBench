{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain.schema.json",
  "title": "RecruitSecBench domain dataset record",
  "description": "One JSONL record containing a CV, vacancy, or candidate answer.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "record_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "record_type": { "type": "string", "enum": ["cv", "vacancy", "candidate_response"] },
    "partition": { "$ref": "common.schema.json#/$defs/partition" },
    "scope": { "$ref": "common.schema.json#/$defs/scope" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "content": {
      "oneOf": [
        { "$ref": "#/$defs/cvContent" },
        { "$ref": "#/$defs/vacancyContent" },
        { "$ref": "#/$defs/responseContent" }
      ]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "required": ["schema_version", "record_id", "record_type", "partition", "scope", "provenance", "content"],
  "allOf": [
    {
      "if": { "properties": { "record_type": { "const": "cv" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/cvContent" } } }
    },
    {
      "if": { "properties": { "record_type": { "const": "vacancy" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/vacancyContent" } } }
    },
    {
      "if": { "properties": { "record_type": { "const": "candidate_response" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/responseContent" } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "cvContent": {
      "type": "object",
      "properties": {
        "kind": { "const": "cv" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "professional_area": { "type": "string", "minLength": 1 },
        "seniority": { "type": "string", "enum": ["intern", "junior", "mid", "senior", "specialist", "manager", "unspecified"] },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "document_id": { "$ref": "common.schema.json#/$defs/identifier" },
              "document_type": { "type": "string", "enum": ["CURRICULUM", "LATTES", "PORTFOLIO", "OTHER"] },
              "language": { "type": "string", "minLength": 2, "maxLength": 16 },
              "text": { "type": "string", "minLength": 1 },
              "structured_data": { "type": "object" },
              "canary_fixture_ids": {
                "type": "array",
                "items": { "$ref": "common.schema.json#/$defs/identifier" },
                "uniqueItems": true
              }
            },
            "required": ["document_id", "document_type", "language", "text"],
            "additionalProperties": false
          }
        }
      },
      "required": ["kind", "candidate_id", "professional_area", "seniority", "documents"],
      "additionalProperties": false
    },
    "vacancyContent": {
      "type": "object",
      "properties": {
        "kind": { "const": "vacancy" },
        "vacancy_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "seniority": { "type": "string", "enum": ["intern", "junior", "mid", "senior", "specialist", "manager", "unspecified"] },
        "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "competencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "evaluation_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "criterion_id": { "$ref": "common.schema.json#/$defs/identifier" },
              "description": { "type": "string", "minLength": 1 },
              "weight": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["criterion_id", "description", "weight"],
            "additionalProperties": false
          }
        },
        "variant_of_record_id": { "$ref": "common.schema.json#/$defs/identifier" }
      },
      "required": ["kind", "vacancy_id", "title", "description", "seniority", "requirements", "competencies", "evaluation_criteria"],
      "additionalProperties": false
    },
    "responseContent": {
      "type": "object",
      "properties": {
        "kind": { "const": "candidate_response" },
        "response_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "application_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "vacancy_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "questionnaire_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "question_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "question_text": { "type": "string", "minLength": 1 },
        "quality_level": { "type": "string", "enum": ["adequate", "partial", "insufficient", "ambiguous", "adversarial"] },
        "answer": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["text", "file_reference"] },
            "text": { "type": "string", "minLength": 1 },
            "file_id": { "$ref": "common.schema.json#/$defs/identifier" }
          },
          "required": ["type"],
          "oneOf": [
            {
              "properties": { "type": { "const": "text" } },
              "required": ["text"],
              "not": { "required": ["file_id"] }
            },
            {
              "properties": { "type": { "const": "file_reference" } },
              "required": ["file_id"],
              "not": { "required": ["text"] }
            }
          ],
          "additionalProperties": false
        },
        "adversarial_case_id": { "$ref": "common.schema.json#/$defs/identifier" }
      },
      "required": ["kind", "response_id", "application_id", "candidate_id", "vacancy_id", "questionnaire_id", "question_id", "question_text", "quality_level", "answer"],
      "allOf": [
        {
          "if": { "properties": { "quality_level": { "const": "adversarial" } } },
          "then": { "required": ["adversarial_case_id"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
