{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deterministic.schema.json",
  "title": "RecruitSecBench deterministic fixture record",
  "description": "Machine-verifiable fixtures for tools, ID relationships, state transitions, scope access, and canaries.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "fixture_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "fixture_type": { "type": "string", "enum": ["tool_call", "id_binding", "state_transition", "scope_access", "canary"] },
    "partition": { "$ref": "common.schema.json#/$defs/partition" },
    "description": { "type": "string", "minLength": 1 },
    "fixture": {
      "oneOf": [
        { "$ref": "#/$defs/toolCall" },
        { "$ref": "#/$defs/idBinding" },
        { "$ref": "#/$defs/stateTransition" },
        { "$ref": "#/$defs/scopeAccess" },
        { "$ref": "#/$defs/canary" }
      ]
    },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "required": ["schema_version", "fixture_id", "fixture_type", "partition", "description", "fixture"],
  "allOf": [
    { "if": { "properties": { "fixture_type": { "const": "tool_call" } } }, "then": { "properties": { "fixture": { "$ref": "#/$defs/toolCall" } } } },
    { "if": { "properties": { "fixture_type": { "const": "id_binding" } } }, "then": { "properties": { "fixture": { "$ref": "#/$defs/idBinding" } } } },
    { "if": { "properties": { "fixture_type": { "const": "state_transition" } } }, "then": { "properties": { "fixture": { "$ref": "#/$defs/stateTransition" } } } },
    { "if": { "properties": { "fixture_type": { "const": "scope_access" } } }, "then": { "properties": { "fixture": { "$ref": "#/$defs/scopeAccess" } } } },
    { "if": { "properties": { "fixture_type": { "const": "canary" } } }, "then": { "properties": { "fixture": { "$ref": "#/$defs/canary" } } } }
  ],
  "additionalProperties": false,
  "$defs": {
    "expectedDecision": {
      "type": "object",
      "properties": {
        "decision": { "$ref": "common.schema.json#/$defs/decision" },
        "reason_code": { "$ref": "common.schema.json#/$defs/identifier" }
      },
      "required": ["decision", "reason_code"],
      "additionalProperties": false
    },
    "toolCall": {
      "type": "object",
      "properties": {
        "kind": { "const": "tool_call" },
        "agent_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "stage": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" },
        "actor": { "$ref": "common.schema.json#/$defs/actorContext" },
        "current_state": { "type": "string", "minLength": 1 },
        "expected": {
          "type": "object",
          "properties": {
            "decision": { "$ref": "common.schema.json#/$defs/decision" },
            "reason_code": { "$ref": "common.schema.json#/$defs/identifier" },
            "normalized_arguments": { "type": "object" },
            "next_state": { "type": ["string", "null"] },
            "side_effect_count": { "type": "integer", "minimum": 0 }
          },
          "required": ["decision", "reason_code", "side_effect_count"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "agent_id", "stage", "tool_name", "arguments", "actor", "current_state", "expected"],
      "additionalProperties": false
    },
    "idBinding": {
      "type": "object",
      "properties": {
        "kind": { "const": "id_binding" },
        "ids": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "left_alias": { "$ref": "common.schema.json#/$defs/identifier" },
              "relation": { "type": "string", "enum": ["belongs_to", "contains", "owned_by", "answers", "uses", "same_scope_as"] },
              "right_alias": { "$ref": "common.schema.json#/$defs/identifier" }
            },
            "required": ["left_alias", "relation", "right_alias"],
            "additionalProperties": false
          }
        },
        "assertion": {
          "type": "object",
          "properties": {
            "expression": { "type": "string", "minLength": 1 },
            "expected_valid": { "type": "boolean" },
            "decision": { "$ref": "common.schema.json#/$defs/decision" },
            "reason_code": { "$ref": "common.schema.json#/$defs/identifier" }
          },
          "required": ["expression", "expected_valid", "decision", "reason_code"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "ids", "relations", "assertion"],
      "additionalProperties": false
    },
    "stateTransition": {
      "type": "object",
      "properties": {
        "kind": { "const": "state_transition" },
        "entity_type": { "type": "string", "enum": ["application", "questionnaire", "hiring_process", "vacancy", "session"] },
        "entity_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "event": { "type": "string", "minLength": 1 },
        "from_state": { "type": "string", "minLength": 1 },
        "to_state": { "type": "string", "minLength": 1 },
        "actor": { "$ref": "common.schema.json#/$defs/actorContext" },
        "expected": { "$ref": "#/$defs/expectedDecision" }
      },
      "required": ["kind", "entity_type", "entity_id", "event", "from_state", "to_state", "actor", "expected"],
      "additionalProperties": false
    },
    "scopeAccess": {
      "type": "object",
      "properties": {
        "kind": { "const": "scope_access" },
        "actor": { "$ref": "common.schema.json#/$defs/actorContext" },
        "operation": { "type": "string", "enum": ["read", "search", "rerank", "chat", "write", "transition", "invoke_tool"] },
        "resource": {
          "type": "object",
          "properties": {
            "resource_type": { "type": "string", "enum": ["cv", "vacancy", "candidate_response", "application", "questionnaire", "session", "tool"] },
            "resource_id": { "$ref": "common.schema.json#/$defs/identifier" },
            "scope": { "$ref": "common.schema.json#/$defs/scope" }
          },
          "required": ["resource_type", "resource_id", "scope"],
          "additionalProperties": false
        },
        "expected": { "$ref": "#/$defs/expectedDecision" }
      },
      "required": ["kind", "actor", "operation", "resource", "expected"],
      "additionalProperties": false
    },
    "canary": {
      "type": "object",
      "properties": {
        "kind": { "const": "canary" },
        "canary_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "token": { "type": "string", "minLength": 12, "pattern": "^RSCB-[A-Z0-9-]+$" },
        "token_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "domain_record_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "json_pointer": { "type": "string", "pattern": "^/" },
        "owner_scope": { "$ref": "common.schema.json#/$defs/scope" },
        "authorized_actor_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true },
        "detect_at": {
          "type": "array",
          "items": { "type": "string", "enum": ["retrieval", "context", "tool_argument", "tool_result", "output", "trace"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "match_mode": { "type": "string", "enum": ["exact", "case_insensitive", "normalized_whitespace"] },
        "expected_out_of_scope_exposure": { "const": false }
      },
      "required": ["kind", "canary_id", "token", "token_sha256", "domain_record_id", "json_pointer", "owner_scope", "authorized_actor_ids", "detect_at", "match_mode", "expected_out_of_scope_exposure"],
      "additionalProperties": false
    }
  }
}
