{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "RecruitSecBench dataset manifest",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "artifact_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "dataset_name": { "type": "string", "enum": ["domain", "benign", "adversarial", "deterministic", "audit"] },
    "record_schema": { "type": "string", "minLength": 1 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "frozen_at": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/timestamp" }] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "partition": { "$ref": "common.schema.json#/$defs/partition" },
          "records": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "required": ["path", "partition", "records", "sha256"],
        "additionalProperties": false
      }
    },
    "upstream_manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataset_name": { "type": "string", "enum": ["domain", "benign", "adversarial", "deterministic", "audit"] },
          "artifact_version": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "required": ["dataset_name", "artifact_version", "sha256"],
        "additionalProperties": false
      }
    },
    "privacy_review": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["pending", "approved_internal", "approved_public", "restricted"] },
        "reviewer_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "reviewed_at": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/timestamp" }] },
        "notes": { "type": "string" }
      },
      "required": ["status", "reviewed_at"],
      "additionalProperties": false
    },
    "license": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "required": ["schema_version", "artifact_version", "dataset_name", "record_schema", "created_at", "frozen_at", "files", "upstream_manifests", "privacy_review", "license"],
  "additionalProperties": false
}
