{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "RecruitSecBench common definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "partition": {
      "type": "string",
      "enum": ["development", "pilot", "evaluation", "holdout"]
    },
    "scope": {
      "type": "object",
      "description": "Canonical authorization and data-isolation coordinates. vacancy_id maps to HiringProcessOpening.id; application_id maps to candidatura_id.",
      "properties": {
        "project_id": { "$ref": "#/$defs/identifier" },
        "hiring_process_id": { "$ref": "#/$defs/identifier" },
        "vacancy_id": { "$ref": "#/$defs/identifier" },
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "application_id": { "$ref": "#/$defs/identifier" },
        "questionnaire_id": { "$ref": "#/$defs/identifier" },
        "actor_id": { "$ref": "#/$defs/identifier" },
        "session_id": { "$ref": "#/$defs/identifier" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": ["real_anonymized", "synthetic", "derived", "mocked"]
        },
        "source_record_id": { "$ref": "#/$defs/identifier" },
        "generator": { "type": "string", "minLength": 1 },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "pii_status": {
          "type": "string",
          "enum": ["not_applicable", "pending_review", "anonymized_reviewed", "restricted_personal_data"]
        },
        "authorization_ref": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      },
      "required": ["source_kind", "generated_at", "content_sha256", "pii_status"],
      "additionalProperties": false
    },
    "actorContext": {
      "type": "object",
      "properties": {
        "actor_id": { "$ref": "#/$defs/identifier" },
        "role": { "type": "string", "minLength": 1 },
        "authenticated": { "type": "boolean" },
        "authorized_scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/scope" },
          "minItems": 1
        }
      },
      "required": ["actor_id", "role", "authenticated", "authorized_scopes"],
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "properties": {
        "oracle_id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "evaluator": {
          "type": "string",
          "enum": ["exact_match", "json_schema", "set_membership", "id_relationship", "state_machine", "policy_engine", "canary_scan", "human_rubric", "llm_judge"]
        },
        "stage": {
          "type": "string",
          "enum": ["request", "retrieval", "context", "tool_call", "tool_result", "state", "session", "output", "trace"]
        },
        "expected": {},
        "parameters": { "type": "object" },
        "primary": { "type": "boolean" }
      },
      "required": ["oracle_id", "description", "evaluator", "stage", "expected", "primary"],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "enum": ["INTERNAL", "GET", "POST", "PUT", "PATCH", "DELETE"] },
        "payload": { "type": "object" },
        "natural_language": { "type": "string" }
      },
      "required": ["entrypoint", "method", "payload"],
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "enum": ["ALLOW", "BLOCK", "HUMAN_REVIEW"]
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "type": "string",
          "enum": ["domain_record", "fixture", "event", "output", "policy_decision", "artifact"]
        },
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["evidence_id", "kind"],
      "additionalProperties": false
    }
  }
}
